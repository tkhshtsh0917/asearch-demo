{
  "$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
  "formatter": {
    "indentStyle": "space",
    "includes": ["**", "!**/*.md", "!**/*.yaml", "!**/*.yml"]
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "files": {
    "includes": [
      "**",
      "!public/data",
      "!vendor",
      "!dist",
      "!public/site",
      "!!integration"
    ]
  },
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  }
}
