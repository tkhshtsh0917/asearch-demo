{
  "$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
  "formatter": {
    "indentStyle": "space",
    "includes": ["**", "!**/*.md", "!**/*.yaml", "!**/*.yml"]
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "files": {
    "includes": [
      "**",
      "!tests/fixtures/builders.mjs",
      "!tests/fixtures/browser-builders.mjs",
      "!vendor",
      "!packages/asearch-wasm/dist",
      "!.engine",
      "!node_modules"
    ]
  }
}
