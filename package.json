{
  "name": "asearch-demo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "data:prepare": "node tools/data/prepare.ts",
    "analysis:prepare": "node tools/analysis/prepare.ts",
    "analysis:update": "node tools/analysis/update.ts && node tools/analysis/prepare.ts",
    "analysis:test": "node --test tools/analysis/live.spec.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.app.json && tsc -p tsconfig.worker.json",
    "lint": "biome check .",
    "fmt": "biome check --write .",
    "docs:check": "node integration/tools/docs/check.mjs --demo && prettier --check \"*.md\" \"docs/**/*.md\" \".github/**/*.yml\"",
    "test": "node --test tools/data/*.test.ts tools/engine/*.test.ts tools/site/*.test.ts tools/analysis/*.test.ts tools/bench/*.test.ts tools/security/*.test.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm docs:check",
    "engine:prepare": "node tools/engine/prepare.ts",
    "engine:build": "node tools/engine/build.ts",
    "data:index": "node tools/site/build.ts",
    "build": "pnpm data:index && vite build",
    "dev": "vite",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:dev": "playwright test --config playwright.dev.config.ts",
    "security:check": "node tools/security/runtime.ts && pnpm audit --audit-level low && pnpm --dir integration audit --audit-level low"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "hyparquet": "1.31.5",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.1.6"
  },
  "dependencies": {
    "asearch-wasm": "file:vendor/asearch-wasm-0.1.0.tgz"
  }
}
