{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "erasableSyntaxOnly": true,
    "lib": ["ES2024", "ESNext.Disposable", "DOM", "DOM.Iterable"],
    "types": ["vite/client"]
  },
  "include": [
    "src/main.ts",
    "src/view/**/*.ts",
    "src/shared/**/*.ts",
    "src/semantic/**/*.ts"
  ]
}
